import type { Metadata } from "next";
import { Playfair_Display, Inter } from "next/font/google";
import "./globals.css";

const playfair = Playfair_Display({
  subsets: ["latin"],
  variable: "--font-playfair",
  display: "swap",
  weight: ["400","500","600","700","800"],
});
const inter = Inter({ subsets: ["latin"], variable: "--font-inter", display: "swap" });

export const metadata: Metadata = {
  title: "LAKSOR — Guides Locaux Certifiés au Maroc",
  description: "Réservez une visite guidée authentique à Marrakech, Fès, Essaouira, Chefchaouen ou Agadir avec des guides locaux certifiés.",
  keywords: ["guide touristique maroc","visite guidée marrakech","guide local fès"],
  openGraph: {
    title: "LAKSOR — Guides Locaux Certifiés au Maroc",
    description: "Réservez une visite guidée authentique avec des guides locaux certifiés.",
    siteName: "LAKSOR", locale: "fr_FR", type: "website",
  },
};

export default function RootLayout({ children }: { children: React.ReactNode }) {
  return (
    <html lang="fr" className={`${playfair.variable} ${inter.variable}`}>
      <body>{children}</body>
    </html>
  );
}
