^X

X
import { prisma } from "@/lib/prisma";

const B = "#123EAB";
const Y = "#F4C542";
const T = "#C96B4B";
const S = "#F8F5F0";

const CATS = [
  { label: "Histoire", emoji: "🏛️", type: "HISTOIRE", color: "#dbeafe" },
  { label: "Culinaire", emoji: "🫖", type: "CULINAIRE", color: "#fef3c7" },
  { label: "Shopping", emoji: "🛍️", type: "SHOPPING", color: "#fce7f3" },
  { label: "Monuments", emoji: "🕌", type: "MONUMENTS", color: "#d1fae5" },
  { label: "Aventure", emoji: "🏕️", type: "AVENTURE", color: "#fff7ed" },
  { label: "Désert", emoji: "🐪", type: "DESERT", color: "#fef9c3" },
];

const TRUST = [
  { icon: "🛡️", title: "Guides certifiés", desc: "Vérifiés et passionnés" },
  { icon: "🔒", title: "Paiement sécurisé", desc: "100% sécurisé en ligne" },
  { icon: "🔄", title: "Annulation flexible", desc: "Gratuite jusqu'à 24h avant" },
  { icon: "💬", title: "Support 7j/7", desc: "Toujours disponible" },
];

export default async function HomePage() {
  const guides = await prisma.guideProfile.findMany({
    where: { status: "APPROVED" },
    take: 4,
    orderBy: { avgRating: "desc" },
  });

  return (
    <div style={{ background: S, minHeight: "100vh" }}>
      <nav style={{ background: "#fff", borderBottom: "1px solid #e8e0d8", padding: "0 clamp(16px,4vw,40px)", height: 66, display: "flex", alignItems: "center", justifyContent: "space-between", position: "sticky", top: 0, zIndex: 200 }}>
        <a href="/" style={{ display: "flex", alignItems: "center", gap: 10 }}>
          <div style={{ width: 40, height: 40, borderRadius: 12, background: B, display: "flex", alignItems: "center", justifyContent: "center" }}>
            <span style={{ color: Y, fontWeight: 900, fontSize: 22, fontFamily: "Georgia, serif" }}>L</span>
          </div>
          <div>
            <div style={{ fontWeight: 800, fontSize: 16, color: B }}>LAKSOR</div>
            <div style={{ fontSize: 9, color: "#aaa", letterSpacing: 1 }}>TOUR GUIDE MOROCCO</div>
          </div>
        </a>
        <div style={{ display: "flex", gap: 10 }}>
          <a href="/auth/login" style={{ fontSize: 14, color: "#444", padding: "10px 16px" }}>Se connecter</a>
          <a href="/auth/register" style={{ background: Y, color: "#1a1a1a", borderRadius: 24, padding: "10px 22px", fontSize: 13, fontWeight: 700 }}>{"S'inscrire"}</a>
        </div>
      </nav>

      <div style={{ position: "relative", height: "clamp(440px, 60vh, 600px)", background: `linear-gradient(135deg, ${B}, #0a2a80)` }}>
        <img src="https://images.unsplash.com/photo-1553522991-fd5deb8e3b50?w=1600&q=80" alt="Chefchaouen" style={{ width: "100%", height: "100%", objectFit: "cover", position: "absolute" }} />
        <div style={{ position: "absolute", inset: 0, background: "linear-gradient(135deg, rgba(10,30,110,0.92), rgba(10,30,110,0.4))" }} />
        <div style={{ position: "absolute", inset: 0, display: "flex", flexDirection: "column", justifyContent: "center", padding: "0 clamp(20px, 5vw, 80px)", maxWidth: 720 }}>
          <div style={{ background: "rgba(244,197,66,0.15)", border: "1px solid rgba(244,197,66,0.4)", borderRadius: 24, padding: "6px 16px", marginBottom: 20, width: "fit-content" }}>
            <span style={{ color: Y, fontWeight: 700, fontSize: 11, letterSpacing: 2 }}>✦ DÉCOUVREZ LE VRAI MAROC</span>
          </div>
          <h1 style={{ color: "#fff", fontSize: "clamp(28px, 4.5vw, 50px)", fontFamily: "Georgia, serif", fontWeight: 700, lineHeight: 1.18, margin: "0 0 18px" }}>
            Trouvez le guide idéal<br />pour une expérience<br />authentique
          </h1>
          <p style={{ color: "rgba(255,255,255,0.92)", fontSize: "clamp(14px, 1.8vw, 18px)", margin: "0 0 32px", maxWidth: 480 }}>
            Des guides locaux passionnés pour vous faire vivre le Maroc autrement.
          </p>
          <a href="/search" style={{ background: Y, color: "#1a1a1a", borderRadius: 32, padding: "15px 36px", fontSize: 16, fontWeight: 700, width: "fit-content" }}>
            Trouver un guide →
          </a>
        </div>
      </div>

      <div style={{ maxWidth: 1020, margin: "-36px auto 0", padding: "0 16px", position: "relative", zIndex: 10 }}>
        <div style={{ background: "#fff", borderRadius: 22, padding: "20px 24px", boxShadow: "0 12px 48px rgba(0,0,0,0.16)" }}>
          <div style={{ display: "grid", gridTemplateColumns: "repeat(auto-fit, minmax(140px, 1fr))", gap: 12, marginBottom: 12 }}>
            {[["📍", "Où ?"], ["🗺️", "Type"], ["📅", "Date"], ["👤", "Pers."]].map(([icon, label]) => (
              <a key={label} href="/search" style={{ border: "1.5px solid #ede8e0", borderRadius: 12, padding: "12px 14px" }}>
                <div style={{ fontSize: 12, color: "#666", fontWeight: 600 }}>{icon} {label}</div>
              </a>
            ))}
          </div>
          <a href="/search" style={{ display: "block", background: B, color: "#fff", borderRadius: 14, padding: 14, fontSize: 14, fontWeight: 700, textAlign: "center" }}>
            🔍 Rechercher un guide
          </a>
        </div>
      </div>

      <div style={{ maxWidth: 1020, margin: "60px auto 0", padding: "0 16px" }}>
        <h2 style={{ fontSize: 22, fontWeight: 800, marginBottom: 24 }}>Catégories populaires</h2>
        <div style={{ display: "flex", gap: 16, overflowX: "auto", paddingBottom: 8 }}>
          {CATS.map((cat) => (
            <a key={cat.type} href={`/search?type=${cat.type}`} style={{ display: "flex", flexDirection: "column", alignItems: "center", gap: 12, minWidth: 100 }}>
              <div style={{ width: 76, height: 76, borderRadius: "50%", background: cat.color, display: "flex", alignItems: "center", justifyContent: "center", fontSize: 30 }}>
                {cat.emoji}
              </div>
              <span style={{ fontSize: 12, fontWeight: 600 }}>{cat.label}</span>
            </a>
          ))}
        </div>
      </div>

      <div style={{ maxWidth: 1020, margin: "60px auto 0", padding: "0 16px" }}>
        <div style={{ marginBottom: 24 }}>
          <div style={{ fontSize: 12, color: T, fontWeight: 700, letterSpacing: 1.5, marginBottom: 6 }}>
            ⚡ DONNÉES LIVE DE SUPABASE
          </div>
          <h2 style={{ fontSize: 22, fontWeight: 800 }}>Guides recommandés ({guides.length})</h2>
        </div>
        <div style={{ display: "grid", gridTemplateColumns: "repeat(auto-fill, minmax(240px, 1fr))", gap: 20 }}>
          {guides.map((g) => (
            <a key={g.id} href={`/guide/${g.id}`}>
              <div style={{ background: "#fff", borderRadius: 22, overflow: "hidden", boxShadow: "0 4px 20px rgba(0,0,0,0.08)" }}>
                <div style={{ position: "relative", height: 220 }}>
                  <img src={g.avatar || ""} alt={g.displayName} loading="lazy" style={{ width: "100%", height: "100%", objectFit: "cover" }} />
                  <div style={{ position: "absolute", inset: 0, background: "linear-gradient(to bottom, transparent 45%, rgba(0,0,0,0.6))" }} />
                  <div style={{ position: "absolute", top: 12, left: 12, background: "#22c55e", color: "#fff", fontSize: 10, fontWeight: 700, borderRadius: 12, padding: "3px 8px" }}>✓ Certifié</div>
                  <div style={{ position: "absolute", bottom: 12, left: 12, color: "#fff", fontSize: 12, fontWeight: 600 }}>📍 {g.city}</div>
                </div>
                <div style={{ padding: 18 }}>
                  <div style={{ fontWeight: 700, fontSize: 16, marginBottom: 6 }}>{g.displayName}</div>
                  <div style={{ display: "flex", alignItems: "center", gap: 6, marginBottom: 14 }}>
                    <span style={{ color: Y, fontSize: 13 }}>★★★★★</span>
                    <span style={{ fontSize: 13, fontWeight: 700 }}>{g.avgRating.toFixed(1)}</span>
                    <span style={{ fontSize: 12, color: "#888" }}>({g.totalReviews} avis)</span>
                  </div>
                  <div style={{ borderTop: "1px solid #f0e8e0", paddingTop: 14, display: "flex", justifyContent: "space-between" }}>
                    <div>
                      <span style={{ fontSize: 19, fontWeight: 800, color: B }}>{g.halfDayPrice} MAD</span>
                      <span style={{ fontSize: 11, color: "#888" }}> / 4h</span>
                    </div>
                    <div>
                      <span style={{ fontSize: 13, fontWeight: 600 }}>{g.fullDayPrice} MAD</span>
                      <span style={{ fontSize: 10, color: "#888" }}> / 8h</span>
                    </div>
                  </div>
                </div>
              </div>
            </a>
          ))}
        </div>
      </div>

      <div style={{ maxWidth: 1020, margin: "60px auto 72px", padding: "0 16px" }}>
        <div style={{ display: "grid", gridTemplateColumns: "repeat(auto-fill, minmax(220px, 1fr))", gap: 24, borderTop: "1px solid #e0d8d0", paddingTop: 48 }}>
          {TRUST.map((t) => (
            <div key={t.title} style={{ display: "flex", gap: 16 }}>
              <div style={{ width: 52, height: 52, borderRadius: 16, background: "#eef2ff", display: "flex", alignItems: "center", justifyContent: "center", fontSize: 24, flexShrink: 0 }}>{t.icon}</div>
              <div>
                <div style={{ fontWeight: 700, fontSize: 14, marginBottom: 4 }}>{t.title}</div>
                <div style={{ fontSize: 12, color: "#666", lineHeight: 1.5 }}>{t.desc}</div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  );
}
