// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── ENUMS ────────────────────────────────────────────────────

enum Role {
  TOURIST
  GUIDE
  ADMIN
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  REFUNDED
}

enum BookingDuration {
  HALF_DAY
  FULL_DAY
}

enum VisitType {
  CULINAIRE
  SHOPPING
  MONUMENTS
  HISTOIRE
  AVENTURE
  DESERT
  ARTISANAT
  EXPERIENCE_LOCALE
  NIGHTLIFE
  PHOTOGRAPHIE
}

enum GuideStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum CustomRequestStatus {
  PENDING
  QUOTED
  ACCEPTED
  REFUSED
}

enum TourType {
  MEDINA_SECRETS
  GASTRONOMIE
  HISTOIRE_MONUMENTS
  DESERT_NATURE
  SHOPPING_ARTISANAT
  COUCHER_SOLEIL
  PHOTO_INSTAGRAM
}

enum TourStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

// ─── MODELS ───────────────────────────────────────────────────

model User {
  id         String   @id @default(cuid())
  supabaseId String   @unique
  email      String   @unique
  name       String?
  avatar     String?
  role       Role     @default(TOURIST)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  guideProfile   GuideProfile?
  bookings       Booking[]       @relation("TouristBookings")
  customRequests CustomRequest[] @relation("TouristRequests")
  reviews        Review[]

  transportBookings TransportBooking[] @relation("TransportBookingUser")
  Transporter       Transporter?

  @@map("users")
}

model GuideProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  displayName   String
  bio           String   @db.Text
  avatar        String?
  phone         String?
  gallery       String[] @default([])
  city          String
  coveredCities String[] @default([])

  languages      String[]    @default([])
  visitTypes     VisitType[] @default([])
  specialties    String[]    @default([])
  certifications String[]    @default([])
  yearsExp       Int         @default(0)
  guideCardUrl   String?
  guideCardBack  String?
  nationalIdUrl  String?
  nationalIdBack String?
  docsStatus     String      @default("PENDING")

  halfDayPrice Float @default(350)
  fullDayPrice Float @default(650)

  status       GuideStatus @default(PENDING)
  avgRating    Float       @default(0)
  totalReviews Int         @default(0)
  views        Int         @default(0)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  bookings        Booking[]
  customRequests  CustomRequest[]
  availability    Availability[]
  tours           GuideTour[]
  customTours     CustomTour[]
  GuideExperience GuideExperience[]

  @@map("guide_profiles")
}

model Booking {
  id        String       @id @default(cuid())
  touristId String
  tourist   User         @relation("TouristBookings", fields: [touristId], references: [id])
  guideId   String
  guide     GuideProfile @relation(fields: [guideId], references: [id])

  date       DateTime
  duration   BookingDuration
  persons    Int             @default(1)
  totalPrice Float
  status     BookingStatus   @default(PENDING)

  stripeSessionId String? @unique
  stripePaymentId String?

  notes     String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  review      Review?
  commission  Float         @default(0)
  slots       BookingSlot[]
  tourBooking TourBooking?

  @@map("bookings")
}

model BookingSlot {
  id        String   @id @default(cuid())
  bookingId String
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  date      DateTime
  duration  String
  price     Float

  @@map("booking_slots")
}

model Review {
  id        String  @id @default(cuid())
  bookingId String  @unique
  booking   Booking @relation(fields: [bookingId], references: [id])
  authorId  String
  author    User    @relation(fields: [authorId], references: [id])
  guideId   String

  rating    Int
  comment   String   @db.Text
  createdAt DateTime @default(now())

  @@map("reviews")
}

model Availability {
  id      String       @id @default(cuid())
  guideId String
  guide   GuideProfile @relation(fields: [guideId], references: [id], onDelete: Cascade)

  date   DateTime
  isFree Boolean  @default(true)

  @@unique([guideId, date])
  @@map("availabilities")
}

model CustomRequest {
  id        String       @id @default(cuid())
  touristId String
  tourist   User         @relation("TouristRequests", fields: [touristId], references: [id])
  guideId   String
  guide     GuideProfile @relation(fields: [guideId], references: [id])

  startDate     DateTime
  days          Int
  persons       Int
  description   String              @db.Text
  proposedPrice Float?
  status        CustomRequestStatus @default(PENDING)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@map("custom_requests")
}

// ─── TOURS ────────────────────────────────────────────────────

model TourTemplate {
  id          String   @id @default(cuid())
  tourType    TourType @unique
  title       String
  description String   @db.Text
  duration    String   @default("4h")
  groupSize   String   @default("1-6 pers.")
  difficulty  String   @default("Facile")
  bestMoment  String   @default("Matin")
  coverImage  String?

  highlights  Json     @default("[]")
  itinerary   Json     @default("[]")
  included    Json     @default("[]")
  notIncluded Json     @default("[]")
  tags        String[] @default([])

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  guideTours GuideTour[]

  @@map("tour_templates")
}

model GuideTour {
  id         String       @id @default(cuid())
  guideId    String
  guide      GuideProfile @relation(fields: [guideId], references: [id], onDelete: Cascade)
  templateId String
  template   TourTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  isActive Boolean @default(false)
  price    Float   @default(0)
  tips     String? @db.Text

  totalBookings Int      @default(0)
  isBestSeller  Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  bookings TourBooking[]

  @@unique([guideId, templateId])
  @@map("guide_tours")
}

model CustomTour {
  id      String       @id @default(cuid())
  guideId String
  guide   GuideProfile @relation(fields: [guideId], references: [id], onDelete: Cascade)

  status    TourStatus @default(PENDING)
  adminNote String?    @db.Text

  title       String
  description String   @db.Text
  price       Float    @default(0)
  duration    String   @default("4h")
  groupSize   String   @default("1-6 pers.")
  difficulty  String   @default("Facile")
  bestMoment  String   @default("Matin")
  coverImage  String?
  tags        String[] @default([])

  highlights  Json    @default("[]")
  itinerary   Json    @default("[]")
  included    Json    @default("[]")
  notIncluded Json    @default("[]")
  tips        String? @db.Text

  isActive      Boolean  @default(false)
  totalBookings Int      @default(0)
  isBestSeller  Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  bookings TourBooking[]

  @@map("custom_tours")
}

model TourBooking {
  id        String  @id @default(cuid())
  bookingId String  @unique
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  guideTourId  String?
  guideTour    GuideTour?  @relation(fields: [guideTourId], references: [id])
  customTourId String?
  customTour   CustomTour? @relation(fields: [customTourId], references: [id])

  createdAt DateTime @default(now())

  @@map("tour_bookings")
}

model GuideExperience {
  id                String       @id @default(cuid())
  guideId           String
  guide             GuideProfile @relation(fields: [guideId], references: [id])
  title             String
  description       String
  duration          String       @default("4h")
  groupSize         String       @default("1-6 pers.")
  difficulty        String       @default("Facile")
  price             Int          @default(0)
  city              String       @default("")
  meetingPoint      String       @default("")
  included          String[]     @default([])
  notIncluded       String[]     @default([])
  itinerary         Json[]       @default([])
  photos            String[]     @default([])
  tags              String[]     @default([])
  transportRequired Boolean      @default(false)
  status            String       @default("PENDING")
  isActive          Boolean      @default(false)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
}

model Transporter {
  id          String             @id @default(cuid())
  userId      String             @unique
  user        User               @relation(fields: [userId], references: [id])
  displayName String
  phone       String?
  city        String             @default("")
  bio         String?            @db.Text
  avatar      String?
  status      String             @default("PENDING")
  vehicles    Vehicle[]
  bookings    TransportBooking[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
}

model Vehicle {
  id            String             @id @default(cuid())
  transporterId String
  transporter   Transporter        @relation(fields: [transporterId], references: [id])
  type          String             @default("SEDAN")
  brand         String?
  model         String?
  year          Int?
  color         String?
  capacity      Int                @default(4)
  hasAC         Boolean            @default(true)
  hasWifi       Boolean            @default(false)
  hasWater      Boolean            @default(false)
  photos        String[]           @default([])
  pricePerKm    Float?
  fixedPrice    Float?
  isActive      Boolean            @default(true)
  bookings      TransportBooking[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
}

model TransportBooking {
  id            String      @id @default(cuid())
  transporterId String
  transporter   Transporter @relation(fields: [transporterId], references: [id])
  vehicleId     String
  vehicle       Vehicle     @relation(fields: [vehicleId], references: [id])
  userId        String?
  user          User?       @relation("TransportBookingUser", fields: [userId], references: [id])
  origin        String
  destination   String
  date          DateTime
  persons       Int         @default(1)
  totalPrice    Float
  status        String      @default("PENDING")
  guestName     String?
  guestContact  String?
  notes         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}
